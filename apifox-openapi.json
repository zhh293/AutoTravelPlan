{
  "openapi": "3.0.0",
  "info": {
    "title": "GaoDeMCPTest API",
    "version": "1.0.0",
    "description": "基于当前项目源码生成的接口文档，支持 Apifox 导入。"
  },
  "servers": [
    {
      "url": "http://localhost:8082",
      "description": "本地开发环境"
    }
  ],
  "paths": {
    "/api/search/suggest": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "地点搜索联想",
        "description": "根据关键词查询地点联想结果，支持城市和类型筛选。",
        "operationId": "searchSuggest",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "搜索关键词"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "城市名称"
          },
          {
            "name": "types",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "POI类型编码"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "页码 (最小为1)"
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50
            },
            "description": "每页条数 (1-50)"
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回分页结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResult_SuggestItem"
                }
              }
            }
          }
        }
      }
    },
    "/api/trip/stream-plan": {
      "get": {
        "tags": [
          "Trip"
        ],
        "summary": "行程规划 (SSE)",
        "description": "生成行程规划，通过 SSE 流式返回。",
        "operationId": "streamPlan",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "maximum": 10
            },
            "description": "游玩天数 (1-10)"
          },
          {
            "name": "preference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "偏好需求"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripPlanItem"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE 流式响应",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "weather": {
                    "summary": "天气事件",
                    "value": "event: trip-weather\ndata: {\"city\":\"北京\",\"days\":[{\"date\":\"2023-10-01\",\"week\":\"1\",\"weather\":\"晴\",\"temp\":\"20\"}]}"
                  },
                  "data": {
                    "summary": "行程数据事件",
                    "value": "event: trip-data\ndata: {\"day\":1,\"title\":\"故宫博物院\",\"lat\":39.916344,\"lng\":116.397155,\"description\":\"...\",\"color\":\"#FF5733\",\"cost\":150}"
                  },
                  "route": {
                    "summary": "路线规划事件",
                    "value": "event: trip-data\ndata: {\"day\":1,\"routePath\":[[116.397,39.916],[116.404,39.908]],\"routeColor\":\"#FF5733\"}"
                  },
                  "done": {
                    "summary": "结束事件",
                    "value": "event: trip-done\ndata: [DONE]"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/image/identify-location": {
      "post": {
        "tags": [
          "Image"
        ],
        "summary": "图片地标识别",
        "description": "上传图片，识别拍摄地点及地标信息。",
        "operationId": "identifyLocation",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "图片文件"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "识别成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result_LocationResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TripPlanItem": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "城市名称"
          },
          "title": {
            "type": "string",
            "description": "标题"
          },
          "lat": {
            "type": "number",
            "format": "double",
            "description": "纬度"
          },
          "lng": {
            "type": "number",
            "format": "double",
            "description": "经度"
          }
        }
      },
      "SuggestItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "POI唯一标识"
          },
          "title": {
            "type": "string",
            "description": "POI名称"
          },
          "titleBold": {
            "type": "boolean",
            "description": "标题是否加粗"
          },
          "subtitle": {
            "type": "string",
            "description": "副标题"
          },
          "subtitleSmall": {
            "type": "boolean",
            "description": "副标题是否小字体"
          },
          "address": {
            "type": "string",
            "description": "详细地址"
          },
          "province": {
            "type": "string",
            "description": "省份"
          },
          "city": {
            "type": "string",
            "description": "城市"
          },
          "district": {
            "type": "string",
            "description": "区县"
          },
          "adcode": {
            "type": "string",
            "description": "行政区划代码"
          },
          "lng": {
            "type": "number",
            "format": "double",
            "description": "经度"
          },
          "lat": {
            "type": "number",
            "format": "double",
            "description": "纬度"
          }
        }
      },
      "PagedResult_SuggestItem": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "当前页码"
          },
          "size": {
            "type": "integer",
            "description": "每页大小"
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "总记录数"
          },
          "fromCache": {
            "type": "boolean",
            "description": "是否来自缓存"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SuggestItem"
            },
            "description": "数据列表"
          }
        }
      },
      "LocationResult": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "识别来源 (EXIF, BAIDU, PICARTA)"
          },
          "formattedAddress": {
            "type": "string",
            "description": "详细地址"
          },
          "country": {
            "type": "string",
            "description": "国家"
          },
          "province": {
            "type": "string",
            "description": "省份"
          },
          "city": {
            "type": "string",
            "description": "城市"
          },
          "district": {
            "type": "string",
            "description": "区县"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "confidence": {
            "type": "number",
            "format": "double",
            "description": "置信度"
          },
          "landmarkName": {
            "type": "string",
            "description": "地标名称"
          }
        }
      },
      "Result_LocationResult": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/LocationResult"
          }
        }
      }
    }
  }
}